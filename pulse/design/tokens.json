{
  "$schema": "Pulse design tokens — Signal Ember. Source of truth for qml/theme/Theme.qml (generated by tools/gen-theme.py) and the Foundations board in design/screens.",
  "version": 1,
  "color": {
    "bg":            { "value": "#111217", "role": "App ground" },
    "surface":       { "value": "#1F2430", "role": "Cards, panels, sidebars" },
    "surfaceRaised": { "value": "#2A2E39", "role": "Selected rows, hover, raised panels" },
    "sunken":        { "value": "#0B0C10", "role": "Slider tracks, segmented wells" },
    "border":        { "value": "#393944", "role": "Dividers and outlines" },
    "text":          { "value": "#F7F4EF", "role": "Primary text and icons" },
    "textEmphasis":  { "value": "#D2D0CB", "role": "Secondary emphasis on dark media" },
    "textSecondary": { "value": "#AAAAB3", "role": "Supporting text" },
    "iconMuted":     { "value": "#6B6F7C", "role": "Drag handles, empty-state icons" },
    "accent":        { "value": "#FF6A28", "role": "Primary actions, active state, progress" },
    "textOnAccent":  { "value": "#111217", "role": "Text and icons on accent (7:1)" },
    "accentText":    { "value": "#FF8A4C", "role": "Accent used as text on dark" },
    "highlight":     { "value": "#FFD166", "role": "Keyboard focus, A–B loop, tips" },
    "error":         { "value": "#FF5A63", "role": "Error borders" },
    "errorText":     { "value": "#FF8A8F", "role": "Error text on dark" },
    "success":       { "value": "#62C999", "role": "Done, live, connected" },
    "scrim":         { "value": "#D9040508", "role": "Video overlay gradient end (ARGB)" }
  },
  "gradient": {
    "accent": ["#FF6A28", "#FF9A3A", "#FFD166"]
  },
  "font": {
    "family": "Inter",
    "display": { "size": 44, "weight": 800, "mobile": 30 },
    "title":   { "size": 32, "weight": 800 },
    "section": { "size": 20, "weight": 700 },
    "body":    { "size": 14, "weight": 500 },
    "meta":    { "size": 12, "weight": 500 },
    "wordmark": { "size": 15, "weight": 700, "letterSpacingEm": 0.32 }
  },
  "space": [4, 8, 12, 16, 24, 32, 48],
  "radius": { "control": 8, "card": 12, "panel": 16, "sheet": 24 },
  "size": {
    "touchTarget": 44,
    "navItem": 44,
    "titleBar": 56,
    "sidebar": 232,
    "playButton": 68,
    "toolsDrawer": 420,
    "compactBreakpoint": 720
  },
  "motion": { "fast": 150, "panel": 250, "controlsHideDelay": 3000, "controlsFade": 200 }
}
