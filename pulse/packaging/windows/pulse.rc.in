// Pulse — Windows resources: application icon and file version details.
#include <winver.h>

IDI_ICON1 ICON "@PULSE_ICON@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Pulse\0"
            VALUE "FileDescription",  "Pulse media player\0"
            VALUE "FileVersion",      "@PROJECT_VERSION@\0"
            VALUE "ProductName",      "Pulse\0"
            VALUE "ProductVersion",   "@PROJECT_VERSION@\0"
            VALUE "LegalCopyright",   "Pulse contributors. Playback by libVLC, VideoLAN and contributors.\0"
            VALUE "OriginalFilename", "pulse.exe\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
